base_rpc_http = "https://mainnet.base.org"
base_rpc_ws   = "wss://YOUR_RPC_WS"
# opsional: endpoint flashblocks Base untuk submit bundle private (hindari race mempublis)
# flashblocks_endpoint = "https://sepolia-preconf.flashbots.net"
private_key   = "0x..."
executor_address = "0x..."

# batas posisi per likuidasi, USD
max_position_usd = 25000
# minimum profit dalam wei collateral token (isi "0" jika ingin selalu kirim)
min_profit_wei = "0"
# fallback jalur B
classic_fallback = true

[swap]
enabled = true
router  = "0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43"  # Aerodrome Router (Base)
slippage_bps = 200          # 2% slippage guard
liquidator_fee_bps = 3000   # 30% bagian liquidator di jalur OEV

