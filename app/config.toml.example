base_rpc_http = "https://mainnet.base.org"
base_rpc_ws   = "wss://YOUR_RPC_WS"

# Envio HyperSync — satu-satunya sumber event log bot.
# RPC free-tier (Alchemy/QuickNode/Chainstack/Dwellir) memblokir `eth_getLogs`
# sehingga pembacaan event Borrow/Mint/Repay/Transfer/UpdatedPrices TIDAK bisa
# lewat RPC biasa. HyperSync adalah query layer yang menuai log tanpa
# menggunakan eth_getLogs. eth_call dan health-check TETAP memakai base_rpc_http.
# Daftar endpoint: https://docs.envio.dev/docs/hypersync/overview
hypersync_url   = "https://base.hypersync.xyz"
# API token dari dashboard Envio (opsional untuk endpoint publik; wajib untuk
# kuota lebih besar/private). Dapat juga diisi via env ENVIO_API_TOKEN.
hypersync_token = ""
# opsional: endpoint Flashblocks Base MAINNET (bukan sepolia) untuk preconf 200ms.
# Semua public endpoint Base sudah Flashblocks-enabled (docs.base.org); contoh:
#   https://mainnet.flashblocks.base.org
# Gunakan endpoint provider privat (Alchemy/QuickNode/Chainstack) bila ingin
# jalur submit privat - tx via mempool publik tetap front-runnable.
# flashblocks_endpoint = "https://mainnet.flashblocks.base.org"
private_key   = "0x..."
executor_address = "0x..."

# batas posisi per likuidasi, USD
max_position_usd = 25000
# minimum profit dalam wei TOKEN HASIL AKHIR (loan token bila swap aktif,
# kolateral bila tidak). Fallback bila simbol tidak ada di map di bawah.
# PERINGATAN: "0" berarti bot mengirim likuidasi berprofit nol — isi nilai
# masuk akal, idealnya via [min_profit_per_symbol].
min_profit_wei = "0"

# batas biaya gas per transaksi dalam wei ETH (default 0.0005 ETH).
# Tx dengan estimasi gas cost di atas ini di-skip — melindungi dari
# min_profit salah konfigurasi atau gas spike.
max_gas_cost_wei = "500000000000000"
# Override per simbol — penting karena desimal beda (WETH 18, USDC 6, cbBTC 8).
# [min_profit_per_symbol]
# WETH = "1000000000000000"   # 0.001 ETH
# USDC = "300000"             # 0.30 USDC
# fallback jalur B
classic_fallback = true

[swap]
enabled = true
router  = "0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43"  # Aerodrome Router (Base)
slippage_bps = 200          # 2% slippage guard
liquidator_fee_bps = 3000   # 30% bagian liquidator di jalur OEV

